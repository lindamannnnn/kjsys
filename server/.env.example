# ============================================
# 胜龙进销存系统 · 环境变量配置
# 使用方式：复制本文件为 .env 并填写真实值
# 注意：.env 含敏感信息，绝不能提交到 Git
# ============================================

# ---- 服务 ----
NODE_ENV=production
PORT=3000
# 对外访问地址（部署时改成你的域名，本地开发留空即可）
API_DOMAIN=

# ---- ⛔ 破坏性操作安全闸门（默认拒绝）----
# 清理测试数据 / 批量播种 / 批量改写库存等脚本，只有 NODE_ENV≠production
# **且** 本开关=1 时才允许执行。
# ⚠️ 生产环境必须保持 0 / 不设置 —— 否则一旦误跑清理脚本会造成不可逆的数据丢失。
ALLOW_DESTRUCTIVE=0

# ---- 数据库 ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=shenglong
DB_USER=shenglong
DB_PASSWORD=shenglong123
# root 密码（docker-compose 初始化用，仅本地开发可留默认）
DB_ROOT_PASSWORD=rootpass

# ---- 身份认证 ----
# 生产环境必须改成一串足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- 微信小程序 ----
# 在微信公众平台 → 开发管理 → 开发设置 中获取
WX_APPID=wxb2fd2feb972e8cbf
WX_SECRET=

# ---------- 企业微信推送（2026-10-14 投产新增）----------
# 消息「双发」：站内信照发 + 企业微信同步推。
# 三样缺一个就等于没启用（只发站内信，不报错）。
# 企业微信管理后台 → 我的企业 → 企业ID；应用管理 → 自建应用 → AgentId / Secret
WECOM_CORPID=
WECOM_AGENTID=
WECOM_SECRET=

# ---- 文件上传 ----
UPLOAD_DIR=/app/uploads

# ---- 后台初始管理员（仅 db:seed 时使用）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
