# ---------- 依赖 ----------
node_modules/
**/node_modules/

# ---------- 敏感配置（务必不要提交）----------
.env
.env.local
.env.*.local
server/.env
*.pem
*.key

# ---------- 运行数据 ----------
data/
server/uploads/
*.log
logs/
npm-debug.log*
yarn-error.log*

# ---------- 构建产物 ----------
dist/
**/dist/
unpackage/
admin/dist/
# 本地沙箱里 vite 清空 admin/dist 会被批量删除保护拦下，
# 于是改用独立输出目录构建；它同样是构建产物，不入库
admin/dist-deploy/
# 2026-10-20：部署专用干净产物目录
#   ⚠️ 必须每次构建到**新目录**：用 --emptyOutDir=false 往旧目录追加构建会累积
#   历史 hash 文件（实测残留 27 个旧 chunk），传上生产就是一堆没人引用的垃圾。
admin/dist-ship/
admin/dist-check/

# ---------- 小程序私有配置 ----------
miniprogram/project.private.config.json
project.private.config.json

# ---------- 编辑器 / 系统 ----------
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------- 临时文件 ----------
*.tmp
*.bak
*.swp
admin/vite.config.js.timestamp-*

# 本地审计 / 真机探针回传目录（临时取证用，不进仓库）
.tmp-local-audit/

# ---------- 本地构建产物 / 本地环境配置 ----------
# devlocal 模式的构建产物（vite build --mode devlocal）
admin/dist-local/
**/dist-local/
# 本地验证用的环境配置（指向本机后端，不该随仓库分发）
.env.devlocal
**/.env.devlocal

# ---------- 测试产物（脚本入库，产物不入库）----------
# 自动化测试跑出来的截图 / report.json / 数据备份
**/tests/**/results/
**/tests/**/_bak_*/
# 临时取证截图
docs/.task-create-*.png
# 闸门 / 冒烟跑出来的结果 JSON（脚本要入库，结果不入库）
server/scripts/out/

# ---------- 例外：需要入库的数据文件 ----------
# 固化的配件编号数据（npm run apply:code 依赖，必须随仓库分发）
!server/data/
server/data/*
!server/data/parts-code.json

# ---------- 含生产账号密码的交付文档，不入库 ----------
docs/角色页面账号对照表-*.html
