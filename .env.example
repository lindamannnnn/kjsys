# ============================================
# 胜龙进销存 · Docker 编排配置（根目录用）
# ============================================
# 用途：`docker compose up -d` 时读取本文件。
# 复制为 .env 后再修改：cp .env.example .env
#
# ⚠️ 与 server/.env 的区别（两个文件服务于两种运行方式）：
#   server/.env      → 后端在本机直接跑（npm start）时读取，数据库走 127.0.0.1:3307
#   根目录 .env      → 整套系统都在 Docker 里跑时读取，数据库走容器内 mysql:3306
#   两种方式选一种即可，见 docs/LOCAL-DEV.md
# ============================================

# ---------- 数据库 ----------
DB_NAME=shenglong
DB_USER=shenglong
DB_PASSWORD=shenglong123
DB_ROOT_PASSWORD=rootpass

# ---------- 运行环境 ----------
NODE_ENV=production

# ---------- 登录令牌签名密钥（生产环境务必替换）----------
# 生成方法：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- 微信小程序 ----------
WX_APPID=
WX_SECRET=

# ---------- 开发者登录开关 ----------
# ⚠️ 生产环境必须为 false，否则可用任意 openid 跳过微信登录
ALLOW_DEV_LOGIN=false

# ---------- 初始管理员（首次 db:seed 时创建）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
